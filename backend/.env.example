# Get this at https://dashboard.networkascode.nokia.io/ after self-registering
NAC_TOKEN=your_nokia_naC_application_key_here

# Optional — if unset, the agent uses a deterministic rule-based explanation
# instead of calling an LLM, so the demo never breaks without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
